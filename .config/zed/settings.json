{
  "agent": {
    "default_model": {
      "provider": "openai-subscribed",
      "model": "gpt-6.1-sol",
      "enable_thinking": true,
      "effort": "low"
    },
    "default_profile": "ask",
    "threads_sidebar": {
      "default_width": 300.0,
      "position": "left"
    },
    "favorite_models": [],
    "model_parameters": []
  },
  "cli_default_open_behavior": "existing_window",
  "disable_ai": true,
  "mouse_wheel_zoom": true,
  "telemetry": {
    "diagnostics": true,
    "metrics": true,
    "anthropic_retention": false
  },
  "terminal": {
    "font_family": "JetBrainsMono Nerd Font",
    "font_size": 18.0
  },
  "status_bar": {
    "experimental.show": false
  },
  "scroll_sensitivity": 2.0,
  "gutter": {
    "line_numbers": true
  },
  "minimap": {
    "show": "always"
  },
  "cursor_blink": false,
  "buffer_font_family": "Berkeley Mono",
  "buffer_font_fallbacks": ["JetBrainsMono Nerd Font"],
  "buffer_font_size": 18.0,
  "buffer_line_height": {
    "custom": 1.4
  },
  "line_ending": "prefer_lf",
  "hard_tabs": false,
  "tab_size": 2,
  "agent_servers": {
    "codex-acp": {
      "type": "registry"
    }
  },
  "icon_theme": "JetBrains New UI Icons (Dark)",
  "base_keymap": "VSCode",
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "git_panel": {
    "dock": "left"
  },
  "vim_mode": true,
  "ui_font_size": 15,
  "ui_font_family": "Inter",
  "theme": "Vague",
  "format_on_save": "on",
  "colorize_brackets": true,
  "languages": {
    "Python": {
      "line_ending": "prefer_lf",
      "hard_tabs": false,
      "tab_size": 4,
      "language_servers": ["ty", "ruff"],
      "formatter": {
        "language_server": {
          "name": "ruff"
        }
      }
    },
    "CSS": {
      "prettier": {
        "allowed": false
      },
      "formatter": {
        "language_server": {
          "name": "oxfmt"
        }
      },
      "language_servers": ["...", "oxfmt"]
    },
    "HTML": {
      "prettier": {
        "allowed": false
      },
      "formatter": {
        "language_server": {
          "name": "oxfmt"
        }
      },
      "language_servers": ["...", "oxfmt"]
    },
    "JavaScript": {
      "prettier": {
        "allowed": false
      },
      "formatter": [
        {
          "language_server": {
            "name": "oxfmt"
          }
        },
        {
          "code_action": "source.fixAll.oxc"
        }
      ],
      "language_servers": ["...", "oxfmt"]
    },
    "JSON": {
      "prettier": {
        "allowed": false
      },
      "formatter": {
        "language_server": {
          "name": "oxfmt"
        }
      },
      "language_servers": ["...", "oxfmt"]
    },
    "JSONC": {
      "prettier": {
        "allowed": false
      },
      "formatter": {
        "language_server": {
          "name": "oxfmt"
        }
      },
      "language_servers": ["...", "oxfmt"]
    },
    "Markdown": {
      "soft_wrap": "none",
      "prettier": {
        "allowed": false
      },
      "formatter": {
        "language_server": {
          "name": "oxfmt"
        }
      },
      "language_servers": ["...", "oxfmt"]
    },
    "TypeScript": {
      "prettier": {
        "allowed": false
      },
      "formatter": {
