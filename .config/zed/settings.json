  "lsp": {
    "ty": {},
    "oxlint": {
      "initialization_options": {
        "settings": {
          "configPath": null,
          "run": "onType",
          "disableNestedConfig": false,
          "fixKind": "safe_fix",
          "unusedDisableDirectives": "deny"
        }
      },
      "binary": {
        "path": "/home/harry/.bun/bin/oxlint",
        "arguments": [
          "--lsp"
        ]
      }
    },
    "oxfmt": {
      "initialization_options": {
        "settings": {
          "fmt.configPath": null,
          "run": "onSave"
        }
      },
      "binary": {
        "path": "/home/harry/.bun/bin/oxfmt",
        "arguments": [
          "--lsp"
        ]
      }
    }
  },
  "markdown_preview": {
    "font_family": "Geist Serif",
    "heading_font_weight": 800,
    "font_size": 18,
    "max_width": 1200
  },
  "vim": {
    "use_system_clipboard": "always",
    "highlight_on_yank_duration": 300,
    "use_smartcase_find": true
  },
  "toolbar": {
    "selections_menu": false,
    "code_actions": false,
    "agent_review": false,
    "quick_actions": false,
    "breadcrumbs": false
  }
}
