nnoremap Y y$

nnoremap <A-u> <C-u>
nnoremap <A-d> <C-d>

nnoremap <C-j> 10jzz
nnoremap <C-k> 10kzz

nnoremap O O<esc>

nnoremap <S-h> :bp<CR>
nnoremap <S-l> :bn<CR>

nnoremap <C-s> :w<CR>
nnoremap <A-s> :w<CR>

nnoremap Q gq

nnoremap <C-S-v> "+p

inoremap <C-s> <esc>:w<CR>
inoremap <A-s> <esc>:w<CR>

inoremap <C-S-v> <C-r>+

vnoremap <C-j> 10j
vnoremap <C-k> 10k

vnoremap <A-u> <C-u>
vnoremap <A-d> <C-d>

vnoremap < <gv
vnoremap > >gv

vnoremap p P

vnoremap <C-s> <esc>:w<CR>
vnoremap <A-s> <esc>:w<CR>

vnoremap <C-S-v> "+p
cnoremap <C-S-v> <C-r>+
