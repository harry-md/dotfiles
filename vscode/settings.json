{
  "window.autoDetectColorScheme": true,
  "editor.fontSize": 18,
  "editor.fontFamily": "Berkeley Mono",
  "editor.fontLigatures": true,
  "terminal.integrated.fontSize": 15,
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff"
  },
  "[json]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[javascript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[typescript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[markdown]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "python.languageServer": "None",
  "cursorpyright.analysis.typeCheckingMode": "off",
  "cursorpyright.disableLanguageServices": false,
  "cursorpyright.analysis.extraPaths": ["${workspaceFolder}/.editor"],
  "notebook.defaultFormatter": "charliermarsh.ruff",
  "notebook.formatOnSave.enabled": true,
  "notebook.markup.fontSize": 16,
  "notebook.output.fontSize": 14,
  "chat.fontSize": 18,
  "chat.editor.fontSize": 15,
  "chat.fontFamily": "Inter",
  "git.openRepositoryInParentFolders": "never",
  "editor.formatOnSave": true,
  "breadcrumbs.enabled": false,
  "keyboard.dispatch": "keyCode",
  "editor.cursorBlinking": "solid",
  "editor.lineNumbers": "relative",
  "editor.tabSize": 4,
  "editor.insertSpaces": true,
  "editor.cursorSurroundingLines": 5,
  "vim.incsearch": true,
  "vim.useSystemClipboard": true,
  "vim.useCtrlKeys": true,
  "vim.vimrc.enable": true,
  "vim.vimrc.path": "~/.config/.vimrc",
  "markdown.preview.fontFamily": "SF Pro Display",
  "vim.normalModeKeyBindingsNonRecursive": [
    {
      "before": ["f", "f"],
      "commands": ["workbench.action.quickOpen"]
    },
    {
      "before": ["f", "g"],
      "commands": ["workbench.action.findInFiles"]
    }
  ],
  "editor.wordWrap": "wordWrapColumn",
  "editor.minimap.maxColumn": 120,
  "editor.rulers": [120],
  "editor.wordWrapColumn": 120,
  "explorer.confirmDelete": false,
  "markdown.preview.fontSize": 20,
  "markdown-preview-enhanced.previewTheme": "vscode.css"
}
